
const express = require('express');
const http = require('http');
const WebSocket = require('ws');
const sqlite3 = require('sqlite3').verbose();
const path = require('path');

const app = express();
const server = http.createServer(app);
const wss = new WebSocket.Server({ server });
const PORT = process.env.PORT === undefined ? 3000 : Number(process.env.PORT);
const DB_PATH = process.env.ARINC_DB_PATH || path.join(__dirname, 'arinc429_local.db');

// Configuración de Base de Datos Local SQLite
const db = new sqlite3.Database(DB_PATH, (err) => {
    if (err) {
        console.error('Error al abrir la base de datos local:', err.message);
        process.exitCode = 1;
    } else {
        console.log('🗄️  Base de datos SQLite local conectada correctamente.');
        initDatabase()
            .then(() => {
                server.listen(PORT, '127.0.0.1', () => {
                    const address = server.address();
                    console.log(`🚀 Servidor ARINC 429 corriendo localmente en: http://127.0.0.1:${address.port}`);
                });
            })
            .catch((initError) => {
                console.error('Error al inicializar la base de datos:', initError.message);
                db.close();
                process.exitCode = 1;
            });
    }
});

function run(sql, params = []) {
    return new Promise((resolve, reject) => {
        db.run(sql, params, function (err) {
            if (err) reject(err);
            else resolve(this);
        });
    });
}

function get(sql, params = []) {
    return new Promise((resolve, reject) => {
        db.get(sql, params, (err, row) => {
            if (err) reject(err);
            else resolve(row);
        });
    });
}

async function initDatabase() {
    await run(`CREATE TABLE IF NOT EXISTS instrumentos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nombre TEXT UNIQUE,
            label_octal INTEGER,
            unidad TEXT,
            min_val REAL,
            max_val REAL
        )`);

    await run(`CREATE TABLE IF NOT EXISTS historial_telemetria (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            instrumento TEXT,
            valor REAL,
            word_hex TEXT,
            word_bin TEXT,
            label_octal INTEGER,
            paridad INTEGER
        )`);

    const row = await get('SELECT COUNT(*) AS count FROM instrumentos');
    if (row.count === 0) {
        const defaults = [
            ['Altímetro', 0o203, 'ft', 0, 50000],
            ['Velocímetro', 0o206, 'knots', 0, 1000],
            ['Horizonte Artificial', 0o324, 'deg', -90, 90]
        ];
        for (const instrument of defaults) {
            await run(
                'INSERT INTO instrumentos (nombre, label_octal, unidad, min_val, max_val) VALUES (?, ?, ?, ?, ?)',
                instrument
            );
        }
        console.log('📋 Instrumentos por defecto cargados en la base de datos local.');
    }
}

// Módulo de Codificación ARINC 429 (32 bits)
function buildArinc429Word(labelOctal, valorNumerico) {
    // 1. Inversión del Label (8 bits) - ARINC 429 transmite el bit más significativo primero para el label
    let labelBinStr = labelOctal.toString(2).padStart(8, '0');
    let reversedLabelStr = labelBinStr.split('').reverse().join('');
    let labelByte = parseInt(reversedLabelStr, 2);

    // 2. SDI (2 bits) -> 00 por defecto
    let sdi = 0;

    // 3. Dato (19 bits) -> Escalado básico BNR
    let dataVal = Math.floor(Math.abs(valorNumerico)) & 0x7FFFF;

    // 4. SSM (2 bits) -> 11 (Operación Normal)
    let ssm = 3;

    // Construcción preliminar de los 31 bits
    let word31 = (ssm << 29) | (dataVal << 10) | (sdi << 8) | labelByte;

    // 5. Paridad Impar (Bit 32)
    let bitCount = 0;
    for (let i = 0; i < 31; i++) {
        if ((word31 >>> i) & 1) bitCount++;
    }
    let parityBit = (bitCount % 2 === 0) ? 1 : 0; // Se fuerza a que el total de unos sea IMPAR

    let finalWord32 = ((parityBit << 31) >>> 0) | word31;

    return {
        binaryStr: (finalWord32 >>> 0).toString(2).padStart(32, '0'),
        hexStr: '0x' + (finalWord32 >>> 0).toString(16).toUpperCase().padStart(8, '0'),
        parityBit: parityBit,
        labelOctalStr: labelOctal.toString(8)
    };
}

// Servir la Interfaz Web Completa Localmente
app.get('/', (req, res) => {
    res.send(`
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ARINC 429 Local Server & Minijuego</title>
        <style>
            :root {
                --bg: #0f172a;
                --panel: #1e293b;
                --accent: #38bdf8;
                --success: #22c55e;
                --warning: #f59e0b;
                --text: #f8fafc;
            }
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--bg);
                color: var(--text);
                margin: 0;
                padding: 20px;
                display: flex;
                flex-direction: column;
                align-items: center;
            }
            h1 { color: var(--accent); text-align: center; margin-bottom: 5px; }
            p.subtitle { color: #94a3b8; margin-top: 0; text-align: center; }
            
            .container {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                max-width: 1100px;
                width: 100%;
            }
            
            .card {
                background: var(--panel);
                border-radius: 12px;
                padding: 20px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
                border: 1px solid #334155;
            }

            .full-width { grid-column: 1 / -1; }

            label { font-weight: bold; display: block; margin-top: 10px; }
            select, input, button {
                width: 100%;
                padding: 10px;
                margin-top: 5px;
                border-radius: 6px;
                border: 1px solid #475569;
                background: #0f172a;
                color: white;
                font-size: 1rem;
                box-sizing: border-box;
            }

            button {
                background: var(--accent);
                color: #0f172a;
                font-weight: bold;
                border: none;
                cursor: pointer;
                margin-top: 15px;
                transition: background 0.2s;
            }
            button:hover { background: #7dd3fc; }

            /* Simulación de Cable LED */
            .cable-container {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #090d16;
                padding: 15px;
                border-radius: 8px;
                margin-top: 15px;
            }
            .led-strip {
                display: flex;
                gap: 8px;
                flex-grow: 1;
                justify-content: center;
                margin: 0 15px;
            }
            .led {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #334155;
                box-shadow: 0 0 2px #000;
                transition: background 0.1s, box-shadow 0.1s;
            }
            .led.active {
                background: var(--accent);
                box-shadow: 0 0 12px var(--accent);
            }
            .led.success {
                background: var(--success);
                box-shadow: 0 0 12px var(--success);
            }

            /* Consola del Binario */
            .binary-display {
                font-family: monospace;
                background: #000;
                color: #00ff66;
                padding: 10px;
                border-radius: 6px;
                word-break: break-all;
                margin-top: 10px;
            }

            /* Minijuego UI */
            .game-buttons {
                display: flex;
                gap: 10px;
                margin-top: 15px;
            }
            .game-btn {
                flex: 1;
                padding: 15px;
                font-size: 1.1rem;
                background: #334155;
                color: white;
                border: 2px solid transparent;
            }
            .game-btn:hover { background: #475569; }
            .score-board {
                font-size: 1.2rem;
                font-weight: bold;
                color: var(--warning);
                margin-top: 10px;
                text-align: center;
            }
        </style>
    </head>
    <body>
        <h1>🛫 ARINC-429-completo</h1>
        <p class="subtitle">Servidor Local & Sistema Interactivo de Telemetría Aeronáutica</p>

        <div class="container">
            <!-- Transmisor de Telemetría -->
            <div class="card">
                <h2>📡 Emisor de Datos (Servidor)</h2>
                <label for="instSelect">Seleccionar Instrumento:</label>
                <select id="instSelect">
                    <option value="203">Altímetro (Label 203 Octal)</option>
                    <option value="206">Velocímetro (Label 206 Octal)</option>
                    <option value="324">Horizonte Artificial (Label 324 Octal)</option>
                </select>

                <label for="valInput">Valor a Transmitir:</label>
                <input type="number" id="valInput" value="3000" placeholder="Ej. 3000">

                <button onclick="transmitirDato()">⚡ Enviar Trama ARINC 429</button>

                <h3>Trama de 32 Bits Resultante:</h3>
                <div class="binary-display" id="binOutput">Esperando transmisión...</div>
                <p id="hexOutput" style="font-family: monospace; color: #94a3b8;"></p>
            </div>

            <!-- Visualizador del Bus de Datos -->
            <div class="card">
                <h2>🔌 Bus de Datos ARINC 429 (Simulado)</h2>
                <p>Visualización del pulso de datos a través del bus diferencial de dos hilos:</p>
                
                <div class="cable-container">
                    <span>TX</span>
                    <div class="led-strip" id="ledStrip">
                        <div class="led"></div><div class="led"></div>
                        <div class="led"></div><div class="led"></div>
                        <div class="led"></div><div class="led"></div>
                        <div class="led"></div><div class="led"></div>
                    </div>
                    <span>RX</span>
                </div>

                <h3>Estado de Paridad:</h3>
                <p id="parityStatus" style="font-weight: bold; color: var(--accent);">Sin datos procesados</p>
            </div>

            <!-- Minijuego Interactivo -->
            <div class="card full-width">
                <h2>🎮 Minijuego: Decodifica la Etiqueta de Cabina</h2>
                <p>Presiona el botón del instrumento correcto cuando veas llegar la etiqueta correspondiente por el bus:</p>
                
                <div class="score-board">Puntuación: <span id="score">0</span> pts</div>

                <div class="game-buttons">
                    <button class="game-btn" onclick="checkAnswer('203')">🏔️ Altímetro<br><small>(Label 203)</small></button>
                    <button class="game-btn" onclick="checkAnswer('206')">🚀 Velocímetro<br><small>(Label 206)</small></button>
                    <button class="game-btn" onclick="checkAnswer('324')">✈️ Horizonte Artificial<br><small>(Label 324)</small></button>
                </div>
                <button style="background: var(--warning); color: #000;" onclick="startNewRound()">🎲 Iniciar Nueva Ronda de Prueba</button>
            </div>
        </div>

        <script>
            let currentGameLabel = null;
            let score = 0;
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            const audioCtx = AudioContextClass ? new AudioContextClass() : null;

            function playSound(freq, duration) {
                if (!audioCtx) return;
                try {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.frequency.value = freq;
                    osc.type = 'sine';
                    osc.start();
                    gain.gain.exponentialRampToValueAtTime(0.00001, audioCtx.currentTime + duration);
                    osc.stop(audioCtx.currentTime + duration);
                } catch(e) {}
            }

            function animateLeds() {
                const leds = document.querySelectorAll('.led');
                leds.forEach((led, i) => {
                    setTimeout(() => {
                        led.classList.add('active');
                        playSound(300 + (i * 100), 0.08);
                        setTimeout(() => led.classList.remove('active'), 150);
                    }, i * 80);
                });
            }

            function transmitirDato() {
                const label = parseInt(document.getElementById('instSelect').value, 8);
                const valor = parseFloat(document.getElementById('valInput').value);

                fetch('/api/transmitir', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ label, valor })
                })
                .then(async res => {
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'No se pudo transmitir la trama.');
                    return data;
                })
                .then(data => {
                    document.getElementById('binOutput').innerText = 'Binario: ' + data.binaryStr;
                    document.getElementById('hexOutput').innerText = 'Hexadecimal: ' + data.hexStr;
                    document.getElementById('parityStatus').innerText = 'Paridad Check: ' + (data.parityBit === 1 ? 'OK (Bit Paridad = 1)' : 'OK (Bit Paridad = 0)');
                    animateLeds();
                })
                .catch(error => {
                    document.getElementById('parityStatus').innerText = error.message;
                });
            }

            function startNewRound() {
                const labels = ['203', '206', '324'];
                currentGameLabel = labels[Math.floor(Math.random() * labels.length)];
                animateLeds();
                alert('¡Atención! Ha salido una trama por el bus. ¿A qué instrumento pertenece?');
            }

            function checkAnswer(selectedLabel) {
                if (!currentGameLabel) {
                    alert('Presiona "Iniciar Nueva Ronda" primero.');
                    return;
                }
                if (selectedLabel === currentGameLabel) {
                    score += 10;
                    document.getElementById('score').innerText = score;
                    playSound(880, 0.3); // Sonido de victoria
                    alert('¡CORRECTO! 🎯 El instrumento reconoció el Label ' + currentGameLabel + ' Octal.');
                } else {
                    playSound(220, 0.4); // Sonido de error
                    alert('❌ INCORRECTO. El Label transmitido era ' + currentGameLabel + '. Este instrumento descartó el mensaje.');
                }
                currentGameLabel = null;
            }
        </script>
    </body>
    </html>
    `);
});

// Endpoint API para procesar y guardar telemetría localmente
app.use(express.json({ limit: '10kb' }));

app.get('/api/instrumentos', (req, res) => {
    db.all('SELECT nombre, label_octal, unidad, min_val, max_val FROM instrumentos ORDER BY id', (err, rows) => {
        if (err) return res.status(500).json({ error: 'No se pudieron consultar los instrumentos.' });
        res.json(rows);
    });
});

wss.on('connection', (socket) => {
    socket.send(JSON.stringify({ type: 'connected', message: 'Conectado al servidor local ARINC 429.' }));
});

app.get('/api/historial', (req, res) => {
    const requestedLimit = Number.parseInt(req.query.limit, 10);
    const limit = Number.isInteger(requestedLimit) ? Math.min(Math.max(requestedLimit, 1), 100) : 20;
    db.all(
        'SELECT id, timestamp, instrumento, valor, word_hex, word_bin, label_octal, paridad FROM historial_telemetria ORDER BY id DESC LIMIT ?',
        [limit],
        (err, rows) => {
            if (err) return res.status(500).json({ error: 'No se pudo consultar el historial.' });
            res.json(rows);
        }
    );
});

app.post('/api/transmitir', (req, res) => {
    const { label, valor } = req.body || {};
    if (!Number.isInteger(label) || !Number.isFinite(valor)) {
        return res.status(400).json({ error: 'Se requiere una etiqueta válida y un valor numérico finito.' });
    }

    db.get('SELECT nombre, unidad, min_val, max_val FROM instrumentos WHERE label_octal = ?', [label], (lookupError, instrument) => {
        if (lookupError) return res.status(500).json({ error: 'No se pudo consultar el instrumento.' });
        if (!instrument) return res.status(400).json({ error: 'La etiqueta no corresponde a un instrumento configurado.' });
        if (valor < instrument.min_val || valor > instrument.max_val) {
            return res.status(422).json({
                error: `El valor debe estar entre ${instrument.min_val} y ${instrument.max_val} ${instrument.unidad}.`
            });
        }

        const arincData = buildArinc429Word(label, valor);
        const record = {
            ...arincData,
            instrumento: instrument.nombre,
            valor,
            unidad: instrument.unidad
        };

        db.run(
            'INSERT INTO historial_telemetria (instrumento, valor, word_hex, word_bin, label_octal, paridad) VALUES (?, ?, ?, ?, ?, ?)',
            [instrument.nombre, valor, arincData.hexStr, arincData.binaryStr, label, arincData.parityBit],
            function (insertError) {
                if (insertError) return res.status(500).json({ error: 'No se pudo guardar la transmisión localmente.' });
                record.id = this.lastID;
                for (const client of wss.clients) {
                    if (client.readyState === WebSocket.OPEN) {
                        client.send(JSON.stringify({ type: 'transmission', data: record }));
                    }
                }
                res.json(record);
            }
        );
    });
});

app.use((err, req, res, next) => {
    if (res.headersSent) return next(err);
    const status = err.status || 500;
    res.status(status).json({ error: status === 400 ? 'La solicitud JSON no es válida.' : 'Error interno del servidor.' });
});